\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Fitted hidden Markov model with jumps (HMM-WJ) internals for SPY with $N = 100$ states.} Panel~(a) overlays the fitted Laplace cumulative distribution function (CDF) on the empirical CDF; the $99$ vertical lines mark the quantile boundaries $Q_k$, equiprobable under the fitted Laplace, that define the hidden states. Panel~(b) displays the estimated transition matrix $\mathbf  {T}$ in $\log _{10}$ color scale, with zero entries at the bottom of the scale; the nonzero entries are scattered across all destination states rather than concentrated near the diagonal. Panel~(c) plots the expected residence time $1/(1 - \mathbf  {T}_{kk})$ under the ordinary transitions for each state on a $\log _{10}$ scale, with the bottom tail set $\mathcal  {S}_{-}$ (states $1$--$5$, red) and the top tail set $\mathcal  {S}_{+}$ (states $96$--$100$, teal) highlighted. The dashed horizontal line marks the fitted mean jump duration $\lambda = 90$ steps, far longer than the residence times of one to two steps.}}{46}{figure.caption.33}\protected@file@percent }
\newlabel{fig:model_internals}{{S3}{46}{\textbf {Fitted hidden Markov model with jumps (HMM-WJ) internals for SPY with $N = 100$ states.} Panel~(a) overlays the fitted Laplace cumulative distribution function (CDF) on the empirical CDF; the $99$ vertical lines mark the quantile boundaries $Q_k$, equiprobable under the fitted Laplace, that define the hidden states. Panel~(b) displays the estimated transition matrix $\mathbf {T}$ in $\log _{10}$ color scale, with zero entries at the bottom of the scale; the nonzero entries are scattered across all destination states rather than concentrated near the diagonal. Panel~(c) plots the expected residence time $1/(1 - \mathbf {T}_{kk})$ under the ordinary transitions for each state on a $\log _{10}$ scale, with the bottom tail set $\mathcal {S}_{-}$ (states $1$--$5$, red) and the top tail set $\mathcal {S}_{+}$ (states $96$--$100$, teal) highlighted. The dashed horizontal line marks the fitted mean jump duration $\lambda = 90$ steps, far longer than the residence times of one to two steps}{figure.caption.33}{}}
