\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Descriptive statistics and stylized-facts tests for SPY daily excess growth rates.} The series is computed from daily volume-weighted average prices, the SPY series used to fit the single-asset generator. In-sample (IS): $2014$--$2024$ ($T = 2{,}766$); out-of-sample (OoS): $2025$ ($T = 249$). The growth rate $G_t$ is the daily log excess return divided by $\Delta t = 1/252$~yr, so its standard deviation is not an annualized volatility; the annualized volatility is $\sigma (G_t)\sqrt  {\Delta t}$, about $13.5\%$ in sample. Gaussian and Laplace columns show maximum likelihood estimation (MLE) fits to the in-sample data. The Laplace MLE location is the sample median and its scale is the mean absolute deviation about the median (Eq.~\eqref  {eq:supp-laplace-mle}), so its mean and standard deviation differ from the sample moments. We applied the Jarque--Bera (JB) normality test and the Ljung--Box (LB) autocorrelation test at lag $20$ to the observed series only. $^{\ast }$ denotes rejection at $\alpha = 0.05$.}}{37}{table.caption.30}\protected@file@percent }
\newlabel{tab:descriptive_stats}{{S1}{37}{\textbf {Descriptive statistics and stylized-facts tests for SPY daily excess growth rates.} The series is computed from daily volume-weighted average prices, the SPY series used to fit the single-asset generator. In-sample (IS): $2014$--$2024$ ($T = 2{,}766$); out-of-sample (OoS): $2025$ ($T = 249$). The growth rate $G_t$ is the daily log excess return divided by $\Delta t = 1/252$~yr, so its standard deviation is not an annualized volatility; the annualized volatility is $\sigma (G_t)\sqrt {\Delta t}$, about $13.5\%$ in sample. Gaussian and Laplace columns show maximum likelihood estimation (MLE) fits to the in-sample data. The Laplace MLE location is the sample median and its scale is the mean absolute deviation about the median (Eq.~\eqref {eq:supp-laplace-mle}), so its mean and standard deviation differ from the sample moments. We applied the Jarque--Bera (JB) normality test and the Ljung--Box (LB) autocorrelation test at lag $20$ to the observed series only. $^{\ast }$ denotes rejection at $\alpha = 0.05$}{table.caption.30}{}}
\citation{rabinerJuang1986}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Closed-form quantities of the fitted SPY generator against sample and simulated values.} Each closed-form entry evaluates an expression derived in this section at the fitted SPY model of Table~\ref {tab:hyperparams}. Sample values are computed from the in-sample SPY series; simulated values use $400$ in-sample-length paths for the jump-episode quantities (forced-step fraction, jump-path probability, and forced fraction within a jump path) and $1{,}000$ paths for skewness. The sup-distance entry is the largest gap between the model's stationary distribution function and the in-sample empirical distribution function; for comparison, the two-sample Kolmogorov--Smirnov critical value used by the path-level tests at $\alpha = 0.05$ for two samples of $T = 2{,}766$ observations is $1.358\sqrt  {2/T} = 0.0365$. Observed autocorrelations are those of the in-sample series shown in Fig.~\ref {fig:empirical_motivation}d.}}{38}{table.caption.31}\protected@file@percent }
\newlabel{tab:supp-generator-quantities}{{S2}{38}{\textbf {Closed-form quantities of the fitted SPY generator against sample and simulated values.} Each closed-form entry evaluates an expression derived in this section at the fitted SPY model of Table~\ref {tab:hyperparams}. Sample values are computed from the in-sample SPY series; simulated values use $400$ in-sample-length paths for the jump-episode quantities (forced-step fraction, jump-path probability, and forced fraction within a jump path) and $1{,}000$ paths for skewness. The sup-distance entry is the largest gap between the model's stationary distribution function and the in-sample empirical distribution function; for comparison, the two-sample Kolmogorov--Smirnov critical value used by the path-level tests at $\alpha = 0.05$ for two samples of $T = 2{,}766$ observations is $1.358\sqrt {2/T} = 0.0365$. Observed autocorrelations are those of the in-sample series shown in Fig.~\ref {fig:empirical_motivation}d}{table.caption.31}{}}
