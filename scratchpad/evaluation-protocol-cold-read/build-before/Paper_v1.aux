\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Cross-asset generalization of the hidden Markov model with jumps (HMM-WJ) across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm  {paths}} = 200$ and $\mathrm  {seed} = 1234$, and the corresponding HMM-WJ Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample (IS; $2014$--$2024$) and out-of-sample (OoS; $2025$) growth-rate history. Values in parentheses are binomial standard errors (SEs) for pass rates. The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima.}}{48}{table.caption.36}\protected@file@percent }
\newlabel{tab:cross_asset}{{S6}{48}{\textbf {Cross-asset generalization of the hidden Markov model with jumps (HMM-WJ) across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm {paths}} = 200$ and $\mathrm {seed} = 1234$, and the corresponding HMM-WJ Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample (IS; $2014$--$2024$) and out-of-sample (OoS; $2025$) growth-rate history. Values in parentheses are binomial standard errors (SEs) for pass rates. The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima}{table.caption.36}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S9}SIM composition derivations and properties verification}{48}{appendix.supp.9}\protected@file@percent }
\newlabel{sec:supp-sim-derivations}{{S9}{48}{SIM composition derivations and properties verification}{appendix.supp.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Calibrated $R^2$ distribution across the $423$ non-SPY tickers.} Histogram of ordinary least-squares (OLS) $R^2$ against SPY over the $2014$--$2024$ window. The two tickers crossing the $R^2_{\mathrm  {preserve}} = 0.80$ threshold (dashed line) are index exchange-traded funds (QQQ, SPYG); the highest-$R^2$ individual stock (BLK, $0.645$) falls $\sim 0.16$ below the threshold. The $R^2$-preserving branch therefore contains only QQQ and SPYG in this universe.}}{49}{figure.caption.37}\protected@file@percent }
\newlabel{fig:r2_distribution}{{S4}{49}{\textbf {Calibrated $R^2$ distribution across the $423$ non-SPY tickers.} Histogram of ordinary least-squares (OLS) $R^2$ against SPY over the $2014$--$2024$ window. The two tickers crossing the $R^2_{\mathrm {preserve}} = 0.80$ threshold (dashed line) are index exchange-traded funds (QQQ, SPYG); the highest-$R^2$ individual stock (BLK, $0.645$) falls $\sim 0.16$ below the threshold. The $R^2$-preserving branch therefore contains only QQQ and SPYG in this universe}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Branch assignment in calibrated $(\beta , R^2_{\mathrm  {real}})$ space.} The $R^2_{\mathrm  {preserve}} = 0.80$ threshold (dashed line) separates tracker assets from single stocks. In this universe, only QQQ and SPYG exceed the threshold, and both are assigned to the $R^2$-preserving branch. The remaining $421$ tickers populate the variance-preserving branch; the clipped variance-preserving branch is unused because the market loading ratio $\rho _i = \beta _i^2 \sigma _m^2 / \sigma _{\mathrm  {gen},i}^2$ stays below $0.90$ for every ticker.}}{50}{figure.caption.38}\protected@file@percent }
\newlabel{fig:branch_map}{{S5}{50}{\textbf {Branch assignment in calibrated $(\beta , R^2_{\real })$ space.} The $R^2_{\mathrm {preserve}} = 0.80$ threshold (dashed line) separates tracker assets from single stocks. In this universe, only QQQ and SPYG exceed the threshold, and both are assigned to the $R^2$-preserving branch. The remaining $421$ tickers populate the variance-preserving branch; the clipped variance-preserving branch is unused because the market loading ratio $\rho _i = \beta _i^2 \sigma _m^2 / \sigma _{\gen ,i}^2$ stays below $0.90$ for every ticker}{figure.caption.38}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Hybrid composition method broken out by branch.} $N_{\mathrm  {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm  {preserve}} = 0.80$ threshold in a training run on the observed SPY path ($100$ replications per ticker); error, $W_1$, and $\kappa $ columns are medians across paths. The row labeled \texttt  {hybrid} is the variance-preserving branch; its clipped case never occurred, because $\rho _i$ stayed below $1 - f = 0.90$ on every composed path. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) had median absolute errors of $0.005$ for $\beta $ and $0.001$ for $R^2$, with a KS pass rate of $100\%$.}}{50}{table.caption.39}\protected@file@percent }
\newlabel{tab:branch}{{S7}{50}{\textbf {Hybrid composition method broken out by branch.} $N_{\mathrm {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm {preserve}} = 0.80$ threshold in a training run on the observed SPY path ($100$ replications per ticker); error, $W_1$, and $\kappa $ columns are medians across paths. The row labeled \texttt {hybrid} is the variance-preserving branch; its clipped case never occurred, because $\rho _i$ stayed below $1 - f = 0.90$ on every composed path. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) had median absolute errors of $0.005$ for $\beta $ and $0.001$ for $R^2$, with a KS pass rate of $100\%$}{table.caption.39}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Restricted Gaussian check of the $R^2$-preserving branch.} Both series used the observed SPY path and independent Gaussian residual draws; the composer used unit residual scale and centered its draw. No full-return model was fitted. Entries are medians over $100$ replications per cell with cross-replication standard deviations in parentheses. Loading and $R^2$ were recovered by ordinary least squares. The nominal Kolmogorov--Smirnov (KS) pass rate is the percentage of comparisons with $p>0.05$; its reference calibration was not established for this design. Every cell used the $R^2$-preserving branch.}}{51}{table.caption.40}\protected@file@percent }
\newlabel{tab:tracker_grid}{{S8}{51}{\textbf {Restricted Gaussian check of the $R^2$-preserving branch.} Both series used the observed SPY path and independent Gaussian residual draws; the composer used unit residual scale and centered its draw. No full-return model was fitted. Entries are medians over $100$ replications per cell with cross-replication standard deviations in parentheses. Loading and $R^2$ were recovered by ordinary least squares. The nominal Kolmogorov--Smirnov (KS) pass rate is the percentage of comparisons with $p>0.05$; its reference calibration was not established for this design. Every cell used the $R^2$-preserving branch}{table.caption.40}{}}
\newlabel{eq:supp-clipped-mean}{{S48}{51}{SIM composition derivations and properties verification}{equation.supp.48}{}}
\newlabel{eq:supp-training-mean-shift}{{S49}{51}{SIM composition derivations and properties verification}{equation.supp.49}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces \textbf  {Clipping-branch stress test under market-volatility scaling.} We used $g_m^{(\gamma )}(t)=\overline  {g}_m+ \gamma [g_m(t)-\overline  {g}_m]$, with $\gamma \in \{1,2,3\}$ and the calibrated marginals held fixed, and re-evaluated the full hybrid composition on the $423$-ticker universe. The transformation preserved the market mean and multiplied its standard deviation by $\gamma $. The fitted intercepts were retained, so clipping could change asset means according to Eq.~\eqref  {eq:supp-clipped-mean}.}}{52}{table.caption.41}\protected@file@percent }
\newlabel{tab:stress}{{S9}{52}{\textbf {Clipping-branch stress test under market-volatility scaling.} We used $g_m^{(\gamma )}(t)=\overline {g}_m+ \gamma [g_m(t)-\overline {g}_m]$, with $\gamma \in \{1,2,3\}$ and the calibrated marginals held fixed, and re-evaluated the full hybrid composition on the $423$-ticker universe. The transformation preserved the market mean and multiplied its standard deviation by $\gamma $. The fitted intercepts were retained, so clipping could change asset means according to Eq.~\eqref {eq:supp-clipped-mean}}{table.caption.41}{}}
\newlabel{eq:supp-zero-sum-terminal}{{S51}{52}{SIM composition derivations and properties verification}{equation.supp.51}{}}
