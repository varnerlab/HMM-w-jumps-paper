\@writefile{lot}{\contentsline {table}{\numberline {S14}{\ignorespaces \textbf  {Paired control for residual centering on common training assets.} Native and centered results use the same $393$ assets and $100$ paths per asset. Centered paths have zero residual mean over $2{,}766$ observations. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) columns give non-rejection percentages at $\alpha =0.05$; higher values indicate closer empirical fit. $W_1$ is median Wasserstein-1 distance, and $|\hat  \alpha -\alpha |$ is median absolute ordinary least squares (OLS) intercept error, both in $\mathrm  {yr}^{-1}$; lower values indicate closer agreement. Naive and hybrid already center each residual path. JumpHMM denotes the hidden Markov generator, with jumps disabled; SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity.}}{57}{table.caption.47}\protected@file@percent }
\newlabel{tab:centering_control}{{S14}{57}{\textbf {Paired control for residual centering on common training assets.} Native and centered results use the same $393$ assets and $100$ paths per asset. Centered paths have zero residual mean over $2{,}766$ observations. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) columns give non-rejection percentages at $\alpha =0.05$; higher values indicate closer empirical fit. $W_1$ is median Wasserstein-1 distance, and $|\hat \alpha -\alpha |$ is median absolute ordinary least squares (OLS) intercept error, both in $\mathrm {yr}^{-1}$; lower values indicate closer agreement. Naive and hybrid already center each residual path. JumpHMM denotes the hidden Markov generator, with jumps disabled; SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity}{table.caption.47}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S12}Pooled one-day tail thresholds}{58}{appendix.supp.12}\protected@file@percent }
\newlabel{sec:supp-var-ensemble}{{S12}{58}{Pooled one-day tail thresholds}{appendix.supp.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces \textbf  {Threshold convergence and independent simulation checks.} Relative changes compare pooled thresholds from $2{,}500$ and $5{,}000$ separate $249$-day paths, divided by the absolute $5{,}000$-path threshold. Median and P95 denote the cross-asset median and $95$th percentile. Simulation rates are mean per-asset exceedance percentages on $1{,}000$ independent paths, using the $5{,}000$-path threshold. Summaries cover the $416$ holdout-eligible assets, or $386$ for generalized autoregressive conditional heteroskedasticity (GARCH). SIM denotes the single-index model; JumpHMM denotes the hidden Markov generator with jumps disabled.}}{58}{table.caption.48}\protected@file@percent }
\newlabel{tab:var_convergence}{{S15}{58}{\textbf {Threshold convergence and independent simulation checks.} Relative changes compare pooled thresholds from $2{,}500$ and $5{,}000$ separate $249$-day paths, divided by the absolute $5{,}000$-path threshold. Median and P95 denote the cross-asset median and $95$th percentile. Simulation rates are mean per-asset exceedance percentages on $1{,}000$ independent paths, using the $5{,}000$-path threshold. Summaries cover the $416$ holdout-eligible assets, or $386$ for generalized autoregressive conditional heteroskedasticity (GARCH). SIM denotes the single-index model; JumpHMM denotes the hidden Markov generator with jumps disabled}{table.caption.48}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S16}{\ignorespaces \textbf  {Pooled-threshold coverage on the common holdout assets.} All methods use the same $386$ assets. Each threshold pools $5{,}000$ separate $249$-day paths, as in Table~\ref {tab:var}. Rate denotes the mean per-asset exceedance percentage on observed $2025$ returns. Standard deviation (SD) describes cross-asset dispersion in percentage points. SIM denotes the single-index model; JumpHMM denotes the hidden Markov generator with jumps disabled; GARCH denotes generalized autoregressive conditional heteroskedasticity.}}{59}{table.caption.49}\protected@file@percent }
\newlabel{tab:var_common}{{S16}{59}{\textbf {Pooled-threshold coverage on the common holdout assets.} All methods use the same $386$ assets. Each threshold pools $5{,}000$ separate $249$-day paths, as in Table~\ref {tab:var}. Rate denotes the mean per-asset exceedance percentage on observed $2025$ returns. Standard deviation (SD) describes cross-asset dispersion in percentage points. SIM denotes the single-index model; JumpHMM denotes the hidden Markov generator with jumps disabled; GARCH denotes generalized autoregressive conditional heteroskedasticity}{table.caption.49}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S13}Emission fallback inventory and sensitivity}{59}{appendix.supp.13}\protected@file@percent }
\newlabel{sec:supp-fallback}{{S13}{59}{Emission fallback inventory and sensitivity}{appendix.supp.13}{}}
\newlabel{eq:emission-fallback}{{S55}{59}{Emission fallback inventory and sensitivity}{equation.supp.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S17}{\ignorespaces \textbf  {Fallback emissions in the full-return training fits.} Each listed asset had one populated constant-return state containing $n_{\rm  c}$ observations. The columns $n_0$ and $n_1$ count empty and singleton states; the other $385$ full-return models required no fallback. Fallback mass is $100\DOTSB \sum@ \slimits@ _{k\in \mathcal  F}\bar  \pi _k$, where $\mathcal  F$ contains all fallback states for that ticker. For populated constant states, the fitted location remained the state mean while the scale used the asset's full training standard deviation. Empty and singleton states used both full-series moments. $\Delta V$ is the percentage change in stationary mixture variance when only the populated constant-state scales are replaced by their empirical values, with all other parameters fixed. These are changes to the uncomposed generator, not variance errors from composition. All fits used $N=100$ and $\nu =5$.}}{60}{table.caption.50}\protected@file@percent }
\newlabel{tab:fallback_assets}{{S17}{60}{\textbf {Fallback emissions in the full-return training fits.} Each listed asset had one populated constant-return state containing $n_{\rm c}$ observations. The columns $n_0$ and $n_1$ count empty and singleton states; the other $385$ full-return models required no fallback. Fallback mass is $100\sum _{k\in \mathcal F}\bar \pi _k$, where $\mathcal F$ contains all fallback states for that ticker. For populated constant states, the fitted location remained the state mean while the scale used the asset's full training standard deviation. Empty and singleton states used both full-series moments. $\Delta V$ is the percentage change in stationary mixture variance when only the populated constant-state scales are replaced by their empirical values, with all other parameters fixed. These are changes to the uncomposed generator, not variance errors from composition. All fits used $N=100$ and $\nu =5$}{table.caption.50}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S18}{\ignorespaces \textbf  {Paired sensitivity to the scale of populated constant states.} Each treatment used $100$ paired training-length paths for each of the same $39$ affected assets. Entries are means over these fixed assets and replications. The empirical-scale treatment changes only populated near-constant states, retaining the sparse-state fallback. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions use $p>0.05$; their changes are percentage points. $W_1$ is the Wasserstein-1 distance to observed growth rates. Variance / observed divides each path's variance by its asset's observed training variance. ACF-MAE$_{25}$ is the mean absolute difference between each path's absolute-return autocorrelation function and the observed function over lags $1$--$25$, calculated before averaging paths. Paired change subtracts the fitted value from the empirical-scale value. Standard errors (SE) use the $100$ replication-level mean paired changes over the fixed asset set and describe simulation uncertainty, not uncertainty across historical markets.}}{61}{table.caption.51}\protected@file@percent }
\newlabel{tab:fallback_sensitivity}{{S18}{61}{\textbf {Paired sensitivity to the scale of populated constant states.} Each treatment used $100$ paired training-length paths for each of the same $39$ affected assets. Entries are means over these fixed assets and replications. The empirical-scale treatment changes only populated near-constant states, retaining the sparse-state fallback. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions use $p>0.05$; their changes are percentage points. $W_1$ is the Wasserstein-1 distance to observed growth rates. Variance / observed divides each path's variance by its asset's observed training variance. ACF-MAE$_{25}$ is the mean absolute difference between each path's absolute-return autocorrelation function and the observed function over lags $1$--$25$, calculated before averaging paths. Paired change subtracts the fitted value from the empirical-scale value. Standard errors (SE) use the $100$ replication-level mean paired changes over the fixed asset set and describe simulation uncertainty, not uncertainty across historical markets}{table.caption.51}{}}
\gdef \@abspage@last{61}
