\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Three-way comparison of emission distributions and duration specifications for SPY.} Standard errors in parentheses; bold marks the best value per row, which for excess kurtosis is the value closest to the observed one. The HSMM is the hidden semi-Markov baseline adapted from Bulla and Bulla (eight states, negative-binomial dwell times with a geometric fallback, and Student-$t$ emissions) \cite  {bullaBulla2006}; HMM-WJ: hidden Markov model with jumps ($N = 100$). All entries are computed from $1{,}000$ simulated paths; pass rates use significance level $\alpha = 0.05$. Kolmogorov--Smirnov (KS), Anderson--Darling (AD), and mean absolute error in the autocorrelation function (ACF-MAE) are defined in Online Appendix~\ref {sec:supp-validation}. Autocorrelation error compares the observed curve with the ensemble-average curve, using lags $1$--$252$ in training and $1$--$248$ in the holdout.}}{47}{table.caption.34}\protected@file@percent }
\newlabel{tab:emission_hsmm}{{S4}{47}{\textbf {Three-way comparison of emission distributions and duration specifications for SPY.} Standard errors in parentheses; bold marks the best value per row, which for excess kurtosis is the value closest to the observed one. The HSMM is the hidden semi-Markov baseline adapted from Bulla and Bulla (eight states, negative-binomial dwell times with a geometric fallback, and Student-$t$ emissions) \cite {bullaBulla2006}; HMM-WJ: hidden Markov model with jumps ($N = 100$). All entries are computed from $1{,}000$ simulated paths; pass rates use significance level $\alpha = 0.05$. Kolmogorov--Smirnov (KS), Anderson--Darling (AD), and mean absolute error in the autocorrelation function (ACF-MAE) are defined in Online Appendix~\ref {sec:supp-validation}. Autocorrelation error compares the observed curve with the ensemble-average curve, using lags $1$--$252$ in training and $1$--$248$ in the holdout}{table.caption.34}{}}
