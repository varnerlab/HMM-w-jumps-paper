\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Hidden Markov model with jumps (HMM-WJ) and single-index model (SIM) composition hyperparameters.} Values used for the main SPY analysis, explored ranges, and locations of sensitivity checks. For the primary six-method SIM comparison, we set $\epsilon = 0$ instead of the SPY value. The separate jump-enabled comparison transferred the listed SPY settings to enabled models. The cross-asset validation used per-ticker $(\epsilon ^{*}, \lambda ^{*})$ values for NVDA, JNJ, and JPM (Table~\ref {tab:cross_asset}).}}{23}{table.caption.15}\protected@file@percent }
\newlabel{tab:hyperparams}{{1}{23}{\textbf {Hidden Markov model with jumps (HMM-WJ) and single-index model (SIM) composition hyperparameters.} Values used for the main SPY analysis, explored ranges, and locations of sensitivity checks. For the primary six-method SIM comparison, we set $\epsilon = 0$ instead of the SPY value. The separate jump-enabled comparison transferred the listed SPY settings to enabled models. The cross-asset validation used per-ticker $(\epsilon ^{*}, \lambda ^{*})$ values for NVDA, JNJ, and JPM (Table~\ref {tab:cross_asset})}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {In-sample and out-of-sample model comparison for SPY.} Results summarize $1{,}000$ simulated paths. Values in parentheses are Monte Carlo standard errors conditional on the fitted model and observed history, and bold entries are best among the fitted generative models within each panel; the empirical bootstrap is excluded from this highlighting. Metric definitions and standard-error calculations are given in Online Appendix~\ref {sec:supp-validation}.}}{23}{table.caption.16}\protected@file@percent }
\newlabel{tab:model_comparison}{{2}{23}{\textbf {In-sample and out-of-sample model comparison for SPY.} Results summarize $1{,}000$ simulated paths. Values in parentheses are Monte Carlo standard errors conditional on the fitted model and observed history, and bold entries are best among the fitted generative models within each panel; the empirical bootstrap is excluded from this highlighting. Metric definitions and standard-error calculations are given in Online Appendix~\ref {sec:supp-validation}}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Aggregate training scorecard with $100$ replications per ticker.} Errors, distances, and tail metrics are medians per method. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions are pooled across replications. $|\hat  \alpha - \alpha |$, $|\hat  \beta - \beta |$, and $|\hat  R^2 - R^2_{\mathrm  {real}}|$: absolute deviation between ordinary least-squares (OLS) recovery and calibration (intercept error has units of $\mathrm  {yr}^{-1}$). KS pass and AD pass: fraction of replications whose two-sample test against the real marginal exceeds $p = 0.05$. $W_1$: Wasserstein-1 distance to the real marginal. $\kappa $: sample excess kurtosis. Hill: tail-index estimate on the upper $5\%$ of $|g|$. SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity. The GARCH method covered $393$ non-market tickers; the other five methods covered $423$.}}{24}{table.caption.17}\protected@file@percent }
\newlabel{tab:aggregate}{{3}{24}{\textbf {Aggregate training scorecard with $100$ replications per ticker.} Errors, distances, and tail metrics are medians per method. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions are pooled across replications. $|\hat \alpha - \alpha |$, $|\hat \beta - \beta |$, and $|\hat R^2 - R^2_{\real }|$: absolute deviation between ordinary least-squares (OLS) recovery and calibration (intercept error has units of $\mathrm {yr}^{-1}$). KS pass and AD pass: fraction of replications whose two-sample test against the real marginal exceeds $p = 0.05$. $W_1$: Wasserstein-1 distance to the real marginal. $\kappa $: sample excess kurtosis. Hill: tail-index estimate on the upper $5\%$ of $|g|$. SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity. The GARCH method covered $393$ non-market tickers; the other five methods covered $423$}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Frozen-parameter multi-asset evaluation on the $2025$ holdout.} Results cover $416$ non-market tickers and $100$ replications per ticker; generalized autoregressive conditional heteroskedasticity (GARCH) covers $386$ tickers. Pass rates are first averaged within ticker and then across tickers. The \textit  {matched in-sample (IS)} columns compare each synthetic path with a randomly selected contiguous $249$-day block from the $2014$--$2024$ training history, matching the holdout sample length. $W_1$ and the variance ratio are medians across ticker-level medians; the variance ratio is synthetic variance divided by observed $2025$ variance. The hybrid correction used the training-period market variance and each simulated asset draw's variance.}}{24}{table.caption.18}\protected@file@percent }
\newlabel{tab:oos_composition}{{4}{24}{\textbf {Frozen-parameter multi-asset evaluation on the $2025$ holdout.} Results cover $416$ non-market tickers and $100$ replications per ticker; generalized autoregressive conditional heteroskedasticity (GARCH) covers $386$ tickers. Pass rates are first averaged within ticker and then across tickers. The \textit {matched in-sample (IS)} columns compare each synthetic path with a randomly selected contiguous $249$-day block from the $2014$--$2024$ training history, matching the holdout sample length. $W_1$ and the variance ratio are medians across ticker-level medians; the variance ratio is synthetic variance divided by observed $2025$ variance. The hybrid correction used the training-period market variance and each simulated asset draw's variance}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Out-of-sample per-ticker one-day left-tail Value-at-Risk coverage across the six composition methods.} For each asset and coverage level $\alpha $, one VaR threshold was estimated from $1{,}245{,}000$ daily log returns pooled across $5{,}000$ separate $249$-day paths with frozen parameters. Exceedances were counted on the observed $2025$ history. The hybrid correction retained the training-period market variance convention of Table~\ref {tab:oos_composition}. \textit  {rate}: mean per-asset exceedance rate (nominal: $1-\alpha $). Standard deviation (SD) describes cross-asset dispersion in percentage points; it is not a standard error. Coverage summaries are descriptive.}}{24}{table.caption.19}\protected@file@percent }
\newlabel{tab:var}{{5}{24}{\textbf {Out-of-sample per-ticker one-day left-tail Value-at-Risk coverage across the six composition methods.} For each asset and coverage level $\alpha $, one VaR threshold was estimated from $1{,}245{,}000$ daily log returns pooled across $5{,}000$ separate $249$-day paths with frozen parameters. Exceedances were counted on the observed $2025$ history. The hybrid correction retained the training-period market variance convention of Table~\ref {tab:oos_composition}. \textit {rate}: mean per-asset exceedance rate (nominal: $1-\alpha $). Standard deviation (SD) describes cross-asset dispersion in percentage points; it is not a standard error. Coverage summaries are descriptive}{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Jump settings under naive and corrected multi-asset composition.} Each setting used $1{,}000$ replications per asset across four seeds, with identical asset and market draws for the two composition methods. SPY was simulated in both windows, and the correction used each simulated market path's variance and each asset draw's variance. Entries are equal-weight cross-ticker means of per-path metrics. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) report non-rejection rates at $\alpha =0.05$. ACF$_{25}$ and ACF$_{60}$ are absolute-return autocorrelation errors through lags $25$ and $60$, calculated within each path before averaging over replications and assets; lower values indicate better temporal fit. $V_{\mathrm  {gen}}=\operatorname  {Var}(g_i)/\sigma _{\mathrm  {gen},i}^2$ compares composed variance with the active generator's variance, rather than observed variance.}}{25}{table.caption.20}\protected@file@percent }
\newlabel{tab:jump_ablation}{{6}{25}{\textbf {Jump settings under naive and corrected multi-asset composition.} Each setting used $1{,}000$ replications per asset across four seeds, with identical asset and market draws for the two composition methods. SPY was simulated in both windows, and the correction used each simulated market path's variance and each asset draw's variance. Entries are equal-weight cross-ticker means of per-path metrics. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) report non-rejection rates at $\alpha =0.05$. ACF$_{25}$ and ACF$_{60}$ are absolute-return autocorrelation errors through lags $25$ and $60$, calculated within each path before averaging over replications and assets; lower values indicate better temporal fit. $V_{\gen }=\Var (g_i)/\sigma _{\gen ,i}^2$ compares composed variance with the active generator's variance, rather than observed variance}{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Empirical stylized facts of SPY daily excess growth rates ($2014$--$2024$).} Panel~(a) shows the heavy-tailed return density; the Laplace maximum-likelihood fit tracks the empirical peak and tails while the Gaussian fit does not. Panel~(b) shows departure from the diagonal in a normal quantile-quantile plot at both extremes. Panel~(c) shows the autocorrelation function of raw excess growth rates. Individual correlations are small, although the Ljung--Box test detects joint serial dependence. Panel~(d) shows the autocorrelation function of absolute excess growth rates, which decays slowly across the reported lags.}}{26}{figure.caption.22}\protected@file@percent }
\newlabel{fig:empirical_motivation}{{1}{26}{\textbf {Empirical stylized facts of SPY daily excess growth rates ($2014$--$2024$).} Panel~(a) shows the heavy-tailed return density; the Laplace maximum-likelihood fit tracks the empirical peak and tails while the Gaussian fit does not. Panel~(b) shows departure from the diagonal in a normal quantile-quantile plot at both extremes. Panel~(c) shows the autocorrelation function of raw excess growth rates. Individual correlations are small, although the Ljung--Box test detects joint serial dependence. Panel~(d) shows the autocorrelation function of absolute excess growth rates, which decays slowly across the reported lags}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Architecture of the hidden Markov model with jumps (HMM-WJ).} When no jump episode is active, the chain transitions according to the empirical transition matrix $\mathbf  {T}$ with probability $1 - \epsilon $ (thin bidirectional arrows) or enters a Poisson jump episode with probability $\epsilon $ (dashed upward arrow to the Poisson clock). During an episode, each of the $K \sim \mathrm  {Poisson}(\lambda )$ forced steps independently draws the bottom tail set $\mathcal  {S}_{-}$ (red, lowest-valued states) with probability $p_{\rm  neg}$ or the top tail set $\mathcal  {S}_{+}$ (blue, highest-valued states) otherwise. Ordinary transitions then resume. Small bell curves above each state show the state-conditional location-scale Student-$t$ ($\nu =5$) emission distribution. Tail sets are defined as the $N_{\rm  tail}$ lowest- and highest-quantile states under the Laplace quantile partition.}}{27}{figure.caption.23}\protected@file@percent }
\newlabel{fig:model_architecture}{{2}{27}{\textbf {Architecture of the hidden Markov model with jumps (HMM-WJ).} When no jump episode is active, the chain transitions according to the empirical transition matrix $\mathbf {T}$ with probability $1 - \epsilon $ (thin bidirectional arrows) or enters a Poisson jump episode with probability $\epsilon $ (dashed upward arrow to the Poisson clock). During an episode, each of the $K \sim \mathrm {Poisson}(\lambda )$ forced steps independently draws the bottom tail set $\mathcal {S}_{-}$ (red, lowest-valued states) with probability $p_{\rm neg}$ or the top tail set $\mathcal {S}_{+}$ (blue, highest-valued states) otherwise. Ordinary transitions then resume. Small bell curves above each state show the state-conditional location-scale Student-$t$ ($\nu =5$) emission distribution. Tail sets are defined as the $N_{\rm tail}$ lowest- and highest-quantile states under the Laplace quantile partition}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Head-to-head in-sample model comparison for SPY} ($N = 100$, $1{,}000$ simulated paths). \emph  {Panel (a):} marginal density of excess growth rates with in-sample Kolmogorov--Smirnov (KS) pass rates annotated per generator. \emph  {Panel (b):} mean autocorrelation function (ACF) of $|G_t|$ at lags $1$--$252$. For the hidden Markov model with jumps (HMM-WJ), the solid curve and its $10$th--$90$th percentile band use jump-active paths; the dashed curve averages all paths. The generalized autoregressive conditional heteroskedasticity (GARCH) band also gives path percentiles. Horizontal dotted lines are the white-noise references $\pm 1.96/\sqrt  {2{,}766}$. \emph  {Panel (c):} tail quantile-quantile plot at the $0.1$st--$99.9$th percentile region per generator.}}{27}{figure.caption.24}\protected@file@percent }
\newlabel{fig:model_comparison}{{3}{27}{\textbf {Head-to-head in-sample model comparison for SPY} ($N = 100$, $1{,}000$ simulated paths). \emph {Panel (a):} marginal density of excess growth rates with in-sample Kolmogorov--Smirnov (KS) pass rates annotated per generator. \emph {Panel (b):} mean autocorrelation function (ACF) of $|G_t|$ at lags $1$--$252$. For the hidden Markov model with jumps (HMM-WJ), the solid curve and its $10$th--$90$th percentile band use jump-active paths; the dashed curve averages all paths. The generalized autoregressive conditional heteroskedasticity (GARCH) band also gives path percentiles. Horizontal dotted lines are the white-noise references $\pm 1.96/\sqrt {2{,}766}$. \emph {Panel (c):} tail quantile-quantile plot at the $0.1$st--$99.9$th percentile region per generator}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Marginal fit and generator-variance preservation under paired composition.} We used $100$ paired paths of $2{,}766$ observations for each of $423$ non-market assets, with the observed $2014$--$2024$ SPY market path and jumps disabled. Blue circles denote naive composition; red diamonds denote hybrid composition. Outlined circles mark the tracker assets QQQ and SPYG in the corresponding method color. \emph  {Panel (a):} each point is the fraction of paths passing the Kolmogorov--Smirnov (KS) test against the observed asset returns at $\alpha =0.05$. \emph  {Panel (b):} each point is the median of the $100$ ratios $\operatorname  {Var}(g_i)/\sigma ^2_{\mathrm  {gen},i}$, with the denominator measured from the same uncomposed generator draw. The dashed line marks the hybrid target of one for the $421$ non-tracker assets. Trackers instead target $\beta _i^2\sigma _m^2/R^2_{\mathrm  {real},i}$ and need not lie on that line. The dotted curve summarizes the per-ticker medians of the naive reference $1+\rho _i$, where $\rho _i=\beta _i^2\sigma _m^2/\sigma ^2_{\mathrm  {gen},i}$ is computed per draw. This reference omits the finite-path covariance term. Solid curves in panel (a) and the dotted curve in panel (b) are Gaussian-kernel weighted medians over non-tracker assets, with bandwidth $0.15$ in calibrated $\beta $. For non-tracker hybrid paths, the median and $95$th percentile of $|\operatorname  {Var}(g_i)/\sigma ^2_{\mathrm  {gen},i}-1|$ were $1.12\%$ and $3.41\%$; ticker medians therefore conceal individual-path variation. The annualized variance of the observed market path was $\Delta t\,\sigma _m^2=0.030~\mathrm  {yr}^{-1}$.}}{28}{figure.caption.25}\protected@file@percent }
\newlabel{fig:preservation}{{4}{28}{\textbf {Marginal fit and generator-variance preservation under paired composition.} We used $100$ paired paths of $2{,}766$ observations for each of $423$ non-market assets, with the observed $2014$--$2024$ SPY market path and jumps disabled. Blue circles denote naive composition; red diamonds denote hybrid composition. Outlined circles mark the tracker assets QQQ and SPYG in the corresponding method color. \emph {Panel (a):} each point is the fraction of paths passing the Kolmogorov--Smirnov (KS) test against the observed asset returns at $\alpha =0.05$. \emph {Panel (b):} each point is the median of the $100$ ratios $\Var (g_i)/\sigma ^2_{\mathrm {gen},i}$, with the denominator measured from the same uncomposed generator draw. The dashed line marks the hybrid target of one for the $421$ non-tracker assets. Trackers instead target $\beta _i^2\sigma _m^2/R^2_{\mathrm {real},i}$ and need not lie on that line. The dotted curve summarizes the per-ticker medians of the naive reference $1+\rho _i$, where $\rho _i=\beta _i^2\sigma _m^2/\sigma ^2_{\mathrm {gen},i}$ is computed per draw. This reference omits the finite-path covariance term. Solid curves in panel (a) and the dotted curve in panel (b) are Gaussian-kernel weighted medians over non-tracker assets, with bandwidth $0.15$ in calibrated $\beta $. For non-tracker hybrid paths, the median and $95$th percentile of $|\Var (g_i)/\sigma ^2_{\mathrm {gen},i}-1|$ were $1.12\%$ and $3.41\%$; ticker medians therefore conceal individual-path variation. The annualized variance of the observed market path was $\Delta t\,\sigma _m^2=0.030~\mathrm {yr}^{-1}$}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Cross-ticker distribution of frozen-parameter out-of-sample marginal fit.} Panel~(a) shows the distribution of per-ticker $2025$ Kolmogorov--Smirnov (KS) pass rates across $100$ replications; the dashed line marks $95\%$. Panel~(b) compares each ticker's hybrid KS pass rate against a matched-length training block with its pass rate against the $2025$ holdout. The diagonal denotes equal performance.}}{28}{figure.caption.26}\protected@file@percent }
\newlabel{fig:oos_composition}{{5}{28}{\textbf {Cross-ticker distribution of frozen-parameter out-of-sample marginal fit.} Panel~(a) shows the distribution of per-ticker $2025$ Kolmogorov--Smirnov (KS) pass rates across $100$ replications; the dashed line marks $95\%$. Panel~(b) compares each ticker's hybrid KS pass rate against a matched-length training block with its pass rate against the $2025$ holdout. The diagonal denotes equal performance}{figure.caption.26}{}}
