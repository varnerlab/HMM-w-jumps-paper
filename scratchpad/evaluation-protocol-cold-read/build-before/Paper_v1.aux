\newlabel{eq:supp-kurt-comp}{{S53}{53}{Role of the centered full-return draw as the residual}{equation.supp.53}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces \textbf  {Aggregate metrics by $\beta $ quartile, across composition methods.} Quartile cutoffs are computed from the calibrated $\beta $ distribution across the $423$-ticker universe. The hybrid KS pass rate declines from $87.6\%$ in Q1 to $65.9\%$ in Q4 as the market loading ratio $\rho _i$ grows; the naive KS pass rate falls from $24.6\%$ to $1.3\%$ over the same range.}}{54}{table.caption.42}\protected@file@percent }
\newlabel{tab:beta_bucket}{{S10}{54}{\textbf {Aggregate metrics by $\beta $ quartile, across composition methods.} Quartile cutoffs are computed from the calibrated $\beta $ distribution across the $423$-ticker universe. The hybrid KS pass rate declines from $87.6\%$ in Q1 to $65.9\%$ in Q4 as the market loading ratio $\rho _i$ grows; the naive KS pass rate falls from $24.6\%$ to $1.3\%$ over the same range}{table.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Heavy-tail preservation: excess kurtosis and Hill tail index vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications. \emph  {Left:} excess kurtosis, $y$-axis clipped to $[-2, 20]$ for readability. The dashed line marks the median real-data excess kurtosis across the universe ($\kappa _{\mathrm  {real}} \approx 13$); the hybrid and naive composition methods (orange and blue) track each other, while the Gaussian single-index model (SIM) stays near $\kappa \approx 1$. \emph  {Right:} Hill tail-index estimator on the upper $5\%$ of $|g|$. The hybrid and naive medians remain near $0.37$ throughout the $\beta $ range; Gaussian SIM sits near $0.22$. Because hybrid tracks naive across the $\beta $ range, the variance rescaling of the hybrid rule does not cause its shortfall from $\kappa _{\mathrm  {real}}$; both carry the generator's tails, diluted by the market term as the market's share of the variance grows (Eq.~\eqref  {eq:supp-kurt-comp}).}}{54}{figure.caption.43}\protected@file@percent }
\newlabel{fig:tails}{{S6}{54}{\textbf {Heavy-tail preservation: excess kurtosis and Hill tail index vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications. \emph {Left:} excess kurtosis, $y$-axis clipped to $[-2, 20]$ for readability. The dashed line marks the median real-data excess kurtosis across the universe ($\kappa _{\real } \approx 13$); the hybrid and naive composition methods (orange and blue) track each other, while the Gaussian single-index model (SIM) stays near $\kappa \approx 1$. \emph {Right:} Hill tail-index estimator on the upper $5\%$ of $|g|$. The hybrid and naive medians remain near $0.37$ throughout the $\beta $ range; Gaussian SIM sits near $0.22$. Because hybrid tracks naive across the $\beta $ range, the variance rescaling of the hybrid rule does not cause its shortfall from $\kappa _{\real }$; both carry the generator's tails, diluted by the market term as the market's share of the variance grows (Eq.~\eqref {eq:supp-kurt-comp})}{figure.caption.43}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S11}{\ignorespaces \textbf  {Simulation check of the kurtosis composition rule.} For each variance share $\rho _i$, $200$ pairs of independent in-sample-length generator paths were standardized and combined as $\sqrt  {\rho _i}\, x + \sqrt  {1 - \rho _i}\, y$. The predicted column evaluates Eq.~\eqref  {eq:supp-kurt-comp} with each pair's sample excess kurtosis; the simulated column is the sample excess kurtosis of the combined series. Both are averaged over the $200$ pairs.}}{55}{table.caption.44}\protected@file@percent }
\newlabel{tab:supp-kurt-composition}{{S11}{55}{\textbf {Simulation check of the kurtosis composition rule.} For each variance share $\rho _i$, $200$ pairs of independent in-sample-length generator paths were standardized and combined as $\sqrt {\rho _i}\, x + \sqrt {1 - \rho _i}\, y$. The predicted column evaluates Eq.~\eqref {eq:supp-kurt-comp} with each pair's sample excess kurtosis; the simulated column is the sample excess kurtosis of the combined series. Both are averaged over the $200$ pairs}{table.caption.44}{}}
