\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Paired control for residual centering on common training assets.} Native and centered results use the same $393$ assets and $100$ paths per asset. Centered paths have zero residual mean over $2{,}766$ observations. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) columns give non-rejection percentages at $\alpha =0.05$; higher values indicate closer empirical fit. $W_1$ is median Wasserstein-1 distance, and $|\hat  \alpha -\alpha |$ is median absolute ordinary least squares (OLS) intercept error, both in $\mathrm  {yr}^{-1}$; lower values indicate closer agreement. Naive and hybrid already center each residual path. JumpHMM denotes the hidden Markov generator, with jumps disabled; SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity.}}{47}{table.caption.33}\protected@file@percent }
\newlabel{tab:centering_control}{{S5}{47}{\textbf {Paired control for residual centering on common training assets.} Native and centered results use the same $393$ assets and $100$ paths per asset. Centered paths have zero residual mean over $2{,}766$ observations. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) columns give non-rejection percentages at $\alpha =0.05$; higher values indicate closer empirical fit. $W_1$ is median Wasserstein-1 distance, and $|\hat \alpha -\alpha |$ is median absolute ordinary least squares (OLS) intercept error, both in $\mathrm {yr}^{-1}$; lower values indicate closer agreement. Naive and hybrid already center each residual path. JumpHMM denotes the hidden Markov generator, with jumps disabled; SIM denotes the single-index model, and GARCH denotes generalized autoregressive conditional heteroskedasticity}{table.caption.33}{}}
