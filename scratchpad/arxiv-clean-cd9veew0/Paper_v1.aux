\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Paired sensitivity to the scale of populated constant states.} Each treatment used $100$ paired training-length paths for each of the same $39$ affected assets. Entries are means over these fixed assets and replications. The empirical-scale treatment changes only populated near-constant states, retaining the sparse-state fallback. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions use $p>0.05$; their changes are percentage points. $W_1$ is the Wasserstein-1 distance to observed growth rates. Variance / observed divides each path's variance by its asset's observed training variance. ACF-MAE$_{25}$ is the mean absolute difference between each path's absolute-return autocorrelation function and the observed function over lags $1$--$25$, calculated before averaging paths. Paired change subtracts the fitted value from the empirical-scale value. Standard errors (SE) use the $100$ replication-level mean paired changes over the fixed asset set and describe simulation uncertainty, not uncertainty across historical markets.}}{49}{table.caption.34}\protected@file@percent }
\newlabel{tab:fallback_sensitivity}{{S6}{49}{\textbf {Paired sensitivity to the scale of populated constant states.} Each treatment used $100$ paired training-length paths for each of the same $39$ affected assets. Entries are means over these fixed assets and replications. The empirical-scale treatment changes only populated near-constant states, retaining the sparse-state fallback. Kolmogorov--Smirnov (KS) and Anderson--Darling (AD) pass fractions use $p>0.05$; their changes are percentage points. $W_1$ is the Wasserstein-1 distance to observed growth rates. Variance / observed divides each path's variance by its asset's observed training variance. ACF-MAE$_{25}$ is the mean absolute difference between each path's absolute-return autocorrelation function and the observed function over lags $1$--$25$, calculated before averaging paths. Paired change subtracts the fitted value from the empirical-scale value. Standard errors (SE) use the $100$ replication-level mean paired changes over the fixed asset set and describe simulation uncertainty, not uncertainty across historical markets}{table.caption.34}{}}
\gdef \@abspage@last{49}
