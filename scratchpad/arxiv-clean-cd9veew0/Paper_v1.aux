\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Heavy-tail preservation: excess kurtosis and Hill tail index vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications. \emph  {Left:} excess kurtosis, $y$-axis clipped to $[-2, 20]$ for readability. The dashed line marks the median real-data excess kurtosis across the universe ($\kappa _{\mathrm  {real}} \approx 13$); the hybrid and naive composition methods (orange and blue) track each other, while the Gaussian single-index model (SIM) stays near $\kappa \approx 1$. \emph  {Right:} Hill tail-index estimator on the upper $5\%$ of $|g|$. The hybrid and naive medians remain near $0.37$ throughout the $\beta $ range; Gaussian SIM sits near $0.22$. The shortfall from $\kappa _{\mathrm  {real}}$ is present with and without variance correction; this similarity does not isolate the effect of rescaling. Both composed distributions depend on the market and generator variance shares (Eq.~\eqref  {eq:supp-kurt-comp}).}}{45}{figure.caption.31}\protected@file@percent }
\newlabel{fig:tails}{{S1}{45}{\textbf {Heavy-tail preservation: excess kurtosis and Hill tail index vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications. \emph {Left:} excess kurtosis, $y$-axis clipped to $[-2, 20]$ for readability. The dashed line marks the median real-data excess kurtosis across the universe ($\kappa _{\real } \approx 13$); the hybrid and naive composition methods (orange and blue) track each other, while the Gaussian single-index model (SIM) stays near $\kappa \approx 1$. \emph {Right:} Hill tail-index estimator on the upper $5\%$ of $|g|$. The hybrid and naive medians remain near $0.37$ throughout the $\beta $ range; Gaussian SIM sits near $0.22$. The shortfall from $\kappa _{\real }$ is present with and without variance correction; this similarity does not isolate the effect of rescaling. Both composed distributions depend on the market and generator variance shares (Eq.~\eqref {eq:supp-kurt-comp})}{figure.caption.31}{}}
