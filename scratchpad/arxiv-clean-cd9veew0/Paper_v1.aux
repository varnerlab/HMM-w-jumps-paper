\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Closed-form quantities of the fitted SPY generator against sample and simulated values.} Entries evaluate the expressions below at the fitted SPY model of Table~\ref {tab:hyperparams}; jump-path entries use the stated single-episode and finite-horizon approximations. Sample values are computed from the in-sample SPY series; simulated values use $400$ in-sample-length paths for the jump-episode quantities (forced-step fraction, jump-path probability, and forced fraction within a jump path) and $1{,}000$ paths for mean sample skewness. The sup-distance entry is the largest gap between the no-jump model's stationary distribution function and the in-sample empirical distribution function; for comparison, the two-sample Kolmogorov--Smirnov critical value used by the path-level tests at $\alpha = 0.05$ for two samples of $T = 2{,}766$ observations is $1.358\sqrt  {2/T} = 0.0365$. Observed autocorrelations are those of the in-sample series shown in Fig.~\ref {fig:empirical_motivation}d. Stationary moments describe the no-jump mixture unless labeled otherwise. Here $A_t=|G_t|$ and $\theta _2$ is the transition matrix's second-largest eigenvalue in modulus.}}{34}{table.caption.28}\protected@file@percent }
\newlabel{tab:supp-generator-quantities}{{S1}{34}{\textbf {Closed-form quantities of the fitted SPY generator against sample and simulated values.} Entries evaluate the expressions below at the fitted SPY model of Table~\ref {tab:hyperparams}; jump-path entries use the stated single-episode and finite-horizon approximations. Sample values are computed from the in-sample SPY series; simulated values use $400$ in-sample-length paths for the jump-episode quantities (forced-step fraction, jump-path probability, and forced fraction within a jump path) and $1{,}000$ paths for mean sample skewness. The sup-distance entry is the largest gap between the no-jump model's stationary distribution function and the in-sample empirical distribution function; for comparison, the two-sample Kolmogorov--Smirnov critical value used by the path-level tests at $\alpha = 0.05$ for two samples of $T = 2{,}766$ observations is $1.358\sqrt {2/T} = 0.0365$. Observed autocorrelations are those of the in-sample series shown in Fig.~\ref {fig:empirical_motivation}d. Stationary moments describe the no-jump mixture unless labeled otherwise. Here $A_t=|G_t|$ and $\theta _2$ is the transition matrix's second-largest eigenvalue in modulus}{table.caption.28}{}}
