\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Dependence model comparison for a four-asset portfolio (SPY, NVDA, JNJ, JPM). Each model uses per-asset HMM marginals ($N=100$, Student-t emissions with $\nu =5$); only the dependence structure differs. 1{,}000 simulated paths, $\alpha =0.05$. Corr Frobenius: root-sum-squared error of upper-triangle correlation entries (observed vs.\ mean simulated). Pairwise corr MAE: mean absolute error across all six asset pairs. SIM results exclude SPY (market factor).}}{22}{table.caption.28}\protected@file@percent }
\newlabel{tab:copula_comparison}{{4}{22}{Dependence model comparison for a four-asset portfolio (SPY, NVDA, JNJ, JPM). Each model uses per-asset HMM marginals ($N=100$, Student-t emissions with $\nu =5$); only the dependence structure differs. 1{,}000 simulated paths, $\alpha =0.05$. Corr Frobenius: root-sum-squared error of upper-triangle correlation entries (observed vs.\ mean simulated). Pairwise corr MAE: mean absolute error across all six asset pairs. SIM results exclude SPY (market factor)}{table.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Simulated price trajectories for the four-asset portfolio under three dependence specifications. All assets start at \$100; prices are reconstructed from excess growth rates via $P_t = P_{t-1}\exp \bigl  ((G_t + r_f)\Delta t\bigr  )$. Panel\nonbreakingspace (a): independent HMM marginals with no cross-asset dependence; drawdowns and rallies occur at unrelated times across tickers. Panel\nonbreakingspace (b): Single-Index Model; assets share partial co-movement via the market factor $\hat  {G}_i = \hat  \alpha _i + \hat  \beta _i G_{\mathrm  {SPY}} + \hat  \eta _i$. Panel\nonbreakingspace (c): Student-t copula; crash episodes and rallies are synchronized across all four assets, particularly in the tails, because the copula reorders each asset's independently simulated values so that extreme days coincide.}}{22}{figure.caption.29}\protected@file@percent }
\newlabel{fig:price_trajectories}{{5}{22}{Simulated price trajectories for the four-asset portfolio under three dependence specifications. All assets start at \$100; prices are reconstructed from excess growth rates via $P_t = P_{t-1}\exp \bigl ((G_t + r_f)\Delta t\bigr )$. Panel~(a): independent HMM marginals with no cross-asset dependence; drawdowns and rallies occur at unrelated times across tickers. Panel~(b): Single-Index Model; assets share partial co-movement via the market factor $\hat {G}_i = \hat \alpha _i + \hat \beta _i G_{\mathrm {SPY}} + \hat \eta _i$. Panel~(c): Student-t copula; crash episodes and rallies are synchronized across all four assets, particularly in the tails, because the copula reorders each asset's independently simulated values so that extreme days coincide}{figure.caption.29}{}}
\@writefile{toc}{\contentsline {paragraph}{Vine copula family selection and the symmetry of equity tail dependence.}{22}{section*.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Dependence model comparison for the four-asset portfolio (SPY, NVDA, JNJ, JPM). Panel\nonbreakingspace (a): KS pass rates by ticker and dependence model. All three copula specifications preserve per-asset marginal fidelity above 95\%, while the SIM degrades to 27.5\% for JPM due to low factor loading ($R^2 = 0.48$). The dashed line marks the 95\% threshold. Panel\nonbreakingspace (b): observed pairwise correlations (lower triangle) vs.\ Student-t copula simulated correlations (upper triangle). The Student-t copula reproduces the cross-asset dependence structure with a pairwise MAE of 0.039; the largest discrepancy is SPY-JNJ (observed 0.47, simulated 0.41).}}{23}{figure.caption.30}\protected@file@percent }
\newlabel{fig:copula_comparison}{{6}{23}{Dependence model comparison for the four-asset portfolio (SPY, NVDA, JNJ, JPM). Panel~(a): KS pass rates by ticker and dependence model. All three copula specifications preserve per-asset marginal fidelity above 95\%, while the SIM degrades to 27.5\% for JPM due to low factor loading ($R^2 = 0.48$). The dashed line marks the 95\% threshold. Panel~(b): observed pairwise correlations (lower triangle) vs.\ Student-t copula simulated correlations (upper triangle). The Student-t copula reproduces the cross-asset dependence structure with a pairwise MAE of 0.039; the largest discrepancy is SPY-JNJ (observed 0.47, simulated 0.41)}{figure.caption.30}{}}
