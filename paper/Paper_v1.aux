\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Statistical validation of HMM-WJ ($N=100$, 1{,}000 simulated paths, $\alpha =0.05$). Panels~(a) and~(b) show the distribution of KS $p$-values in-sample and out-of-sample, respectively; a well-calibrated generative model produces $p$-values that are approximately uniform above the significance threshold. Panel~(c) shows the out-of-sample marginal density fan chart. Panel~(d) shows persistence of volatility clustering in the out-of-sample window.}}{33}{figure.caption.33}\protected@file@percent }
\newlabel{fig:statistical_validation}{{6}{33}{Statistical validation of HMM-WJ ($N=100$, 1{,}000 simulated paths, $\alpha =0.05$). Panels~(a) and~(b) show the distribution of KS $p$-values in-sample and out-of-sample, respectively; a well-calibrated generative model produces $p$-values that are approximately uniform above the significance threshold. Panel~(c) shows the out-of-sample marginal density fan chart. Panel~(d) shows persistence of volatility clustering in the out-of-sample window}{figure.caption.33}{}}
