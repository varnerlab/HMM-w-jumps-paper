\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cross-sectional summary statistics for the Single-Index Model (SIM) extension across S\&P\nonbreakingspace 500 constituents. Individual asset paths are generated as $\hat  {G}_{i,t}=\hat  {\alpha }_i+\hat  {\beta }_i G_{{\rm  SPY},t}+\hat  {\eta }_{i,t}$ where $G_{{\rm  SPY},t}$ is drawn from HMM-WJ ($N=100$) simulated paths and $\hat  {\eta }_{i,t}$ is resampled from empirical residuals. KS pass rates computed over 1{,}000 paths at $\alpha =0.05$.}}{21}{table.caption.27}\protected@file@percent }
\newlabel{tab:multi_asset}{{3}{21}{Cross-sectional summary statistics for the Single-Index Model (SIM) extension across S\&P~500 constituents. Individual asset paths are generated as $\hat {G}_{i,t}=\hat {\alpha }_i+\hat {\beta }_i G_{{\rm SPY},t}+\hat {\eta }_{i,t}$ where $G_{{\rm SPY},t}$ is drawn from HMM-WJ ($N=100$) simulated paths and $\hat {\eta }_{i,t}$ is resampled from empirical residuals. KS pass rates computed over 1{,}000 paths at $\alpha =0.05$}{table.caption.27}{}}
