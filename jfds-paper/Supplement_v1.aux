\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Three-way comparison of emission distributions and duration specifications for SPY.} Standard errors in parentheses; bold marks the best value per row. HSMM: hidden semi-Markov model ($K = 8$ states, negative-binomial dwell times, Student-$t$ emissions) \cite  {bullaBulla2006}; HMM-WJ: hybrid hidden Markov model with jump-duration override ($N = 100$). All entries are computed from $1{,}000$ simulated paths at significance level $\alpha = 0.05$.}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:emission_hsmm}{{S3}{9}{\textbf {Three-way comparison of emission distributions and duration specifications for SPY.} Standard errors in parentheses; bold marks the best value per row. HSMM: hidden semi-Markov model ($K = 8$ states, negative-binomial dwell times, Student-$t$ emissions) \cite {bullaBulla2006}; HMM-WJ: hybrid hidden Markov model with jump-duration override ($N = 100$). All entries are computed from $1{,}000$ simulated paths at significance level $\alpha = 0.05$}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Hybrid composition method broken out by branch.} $N_{\mathrm  {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm  {preserve}} = 0.80$ threshold. The clipped variance-preserving branch does not trigger anywhere in the universe ($\rho _i < 0.90$ for all tickers) and is omitted. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) had median absolute errors of $0.005$ for $\beta $ and $0.001$ for $R^2$, with a KS pass rate of $99\%$.}}{9}{table.caption.10}\protected@file@percent }
\newlabel{tab:branch}{{S4}{9}{\textbf {Hybrid composition method broken out by branch.} $N_{\mathrm {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm {preserve}} = 0.80$ threshold. The clipped variance-preserving branch does not trigger anywhere in the universe ($\rho _i < 0.90$ for all tickers) and is omitted. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) had median absolute errors of $0.005$ for $\beta $ and $0.001$ for $R^2$, with a KS pass rate of $99\%$}{table.caption.10}{}}
