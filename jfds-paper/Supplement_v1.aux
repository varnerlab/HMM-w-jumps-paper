\@writefile{lot}{\contentsline {table}{\numberline {S11}{\ignorespaces \textbf  {Simulation check of the kurtosis composition rule.} For each variance share $\rho _i$, $200$ pairs of independent in-sample-length generator paths were standardized and combined as $\sqrt  {\rho _i}\, x + \sqrt  {1 - \rho _i}\, y$. The predicted column evaluates Eq.~\eqref  {eq:supp-kurt-comp} with each pair's sample excess kurtosis; the simulated column is the sample excess kurtosis of the combined series. Both are averaged over the $200$ pairs.}}{27}{}\protected@file@percent }
