\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Three-way comparison of emission distributions and duration specifications for SPY.} Standard errors in parentheses; bold marks the best value per row. HSMM: hidden semi-Markov model ($K = 8$ states, negative-binomial dwell times, Student-$t$ emissions) \citep  {bullaBulla2006}; HMM-WJ: hybrid hidden Markov model with jump-duration override ($N = 100$). All entries are computed from $1{,}000$ simulated paths at significance level $\alpha = 0.05$.}}{12}{}\protected@file@percent }
