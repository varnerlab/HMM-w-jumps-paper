\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces \textbf  {Threshold convergence and independent simulation checks.} Relative changes compare pooled thresholds from $2{,}500$ and $5{,}000$ separate $249$-day paths, divided by the absolute $5{,}000$-path threshold. Median and P95 denote the cross-asset median and $95$th percentile. Simulation rates are mean per-asset exceedance percentages on $1{,}000$ independent paths, using the $5{,}000$-path threshold. Summaries cover the $416$ holdout-eligible assets, or $386$ for generalized autoregressive conditional heteroskedasticity (GARCH). SIM denotes the single-index model; JumpHMM denotes the hidden Markov generator with jumps disabled.}}{36}{}\protected@file@percent }
\newlabel{tab:var_convergence}{{S15}{36}{}{table.15}{}}
