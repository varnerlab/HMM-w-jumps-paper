\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm  {paths}} = 200$ and $\mathrm  {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima.}}{12}{table.caption.15}\protected@file@percent }
\newlabel{tab:cross_asset}{{S7}{12}{\textbf {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm {paths}} = 200$ and $\mathrm {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The hybrid--JumpHMM-on-residuals difference in KS pass rate is $25$ percentage points, compared with hybrid's across-seed SD of $0.18$ percentage points.}}{12}{table.caption.16}\protected@file@percent }
\newlabel{tab:seed_uncertainty}{{S8}{12}{\textbf {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The hybrid--JumpHMM-on-residuals difference in KS pass rate is $25$ percentage points, compared with hybrid's across-seed SD of $0.18$ percentage points}{table.caption.16}{}}
