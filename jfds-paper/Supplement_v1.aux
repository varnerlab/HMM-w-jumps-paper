\@writefile{lot}{\contentsline {table}{\numberline {S12}{\ignorespaces \textbf  {Monte Carlo uncertainty in the effect of jump settings under corrected composition.} Differences are relative to jumps disabled, with $1{,}000$ market replications per window. $\Delta $ACF$_{25}$ is the change in mean absolute error of the absolute-return autocorrelation function through lag $25$; negative values indicate improved temporal fit. $\Delta $KS is the change in Kolmogorov--Smirnov non-rejection rate in percentage points. Brackets contain approximate $95\%$ Monte Carlo (MC) intervals conditional on the fitted models and observed histories.}}{32}{}\protected@file@percent }
\newlabel{tab:jump_ablation_uncertainty}{{S12}{32}{}{table.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S13}{\ignorespaces \textbf  {Episode incidence and breadth of the temporal change in the multi-asset jump comparison.} SPY paths with an episode are counted over the $1{,}000$ jump-enabled market replications per window. Asset paths with an episode is the mean jump-active share across the enabled asset generators. The last two columns give the share of assets whose mean absolute-return autocorrelation error through lag $25$ fell under corrected composition when jumps were enabled in the market only, or in the market and the assets, relative to jumps disabled.}}{32}{}\protected@file@percent }
\newlabel{tab:jump_ablation_episodes}{{S13}{32}{}{table.13}{}}
