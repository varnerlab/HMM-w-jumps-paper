\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Descriptive statistics and stylized-facts tests for SPY daily excess growth rates.} In-sample (IS): $2014$--$2024$ ($T = 2{,}766$); out-of-sample (OoS): $2025$ ($T = 249$). Gaussian and Laplace columns show maximum likelihood estimation (MLE) fits to the in-sample data. We used the Jarque--Bera (JB) normality test and the Ljung--Box (LB) autocorrelation test at lag $20$. $^{\ast }$ denotes rejection at $\alpha = 0.05$.}}{7}{}\protected@file@percent }
\newlabel{tab:descriptive_stats}{{S1}{7}{}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Closed-form quantities of the fitted SPY generator against sample and simulated values.} Each closed-form entry evaluates the expression named in the text at the fitted SPY model of Table~\ref {tab:hyperparams}. Sample values are computed from the in-sample SPY series; simulated values use $400$ in-sample-length paths for the jump-episode quantities and $1{,}000$ paths for skewness. For comparison with the sup-distance entry, the two-sample Kolmogorov--Smirnov critical value at $\alpha = 0.05$ for two samples of $T = 2{,}766$ observations is $1.358\sqrt  {2/T} = 0.0365$. Observed autocorrelations are those of the in-sample series shown in Fig.~\ref {fig:empirical_motivation}d.}}{8}{}\protected@file@percent }
