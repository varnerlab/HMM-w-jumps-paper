\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Fitted HMM-WJ internals for SPY with $N = 100$ states.} Panel~(a) overlays the fitted Laplace CDF on the empirical CDF; the $99$ vertical lines mark the equal-probability quantile boundaries $Q_k$ that define the hidden states. Panel~(b) displays the estimated transition matrix $\mathbf  {T}$ in $\log _{10}$ color scale; the dominant near-diagonal band reflects short-range regime persistence. Panel~(c) plots the expected natural residence time $1/(1 - T_{kk})$ for each state on a $\log _{10}$ scale, with the bottom tail set $\mathcal  {S}_{-}$ (states $1$--$5$, red) and the top tail set $\mathcal  {S}_{+}$ (states $96$--$100$, teal) highlighted. The dashed horizontal line marks the fitted mean jump duration $\lambda = 100$ steps, quantifying the two-order-of-magnitude gap between natural residence times and the jump-duration override.}}{28}{figure.caption.21}\protected@file@percent }
\newlabel{fig:model_internals}{{S5}{28}{\textbf {Fitted HMM-WJ internals for SPY with $N = 100$ states.} Panel~(a) overlays the fitted Laplace CDF on the empirical CDF; the $99$ vertical lines mark the equal-probability quantile boundaries $Q_k$ that define the hidden states. Panel~(b) displays the estimated transition matrix $\mathbf {T}$ in $\log _{10}$ color scale; the dominant near-diagonal band reflects short-range regime persistence. Panel~(c) plots the expected natural residence time $1/(1 - T_{kk})$ for each state on a $\log _{10}$ scale, with the bottom tail set $\mathcal {S}_{-}$ (states $1$--$5$, red) and the top tail set $\mathcal {S}_{+}$ (states $96$--$100$, teal) highlighted. The dashed horizontal line marks the fitted mean jump duration $\lambda = 100$ steps, quantifying the two-order-of-magnitude gap between natural residence times and the jump-duration override}{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Three-way comparison isolating the emission distribution and the duration model for SPY.} Standard errors in parentheses; bold marks the best value per row. HSMM: hidden semi-Markov model ($K = 8$ states, negative-binomial dwell times, Student-$t$ emissions) \cite  {bullaBulla2006}; HMM-WJ: hybrid hidden Markov model with jump-duration override ($N = 100$). All entries are computed from $1{,}000$ simulated paths at significance level $\alpha = 0.05$.}}{28}{table.caption.22}\protected@file@percent }
\newlabel{tab:emission_hsmm}{{S3}{28}{\textbf {Three-way comparison isolating the emission distribution and the duration model for SPY.} Standard errors in parentheses; bold marks the best value per row. HSMM: hidden semi-Markov model ($K = 8$ states, negative-binomial dwell times, Student-$t$ emissions) \cite {bullaBulla2006}; HMM-WJ: hybrid hidden Markov model with jump-duration override ($N = 100$). All entries are computed from $1{,}000$ simulated paths at significance level $\alpha = 0.05$}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Hybrid composition method broken out by branch.} $N_{\mathrm  {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm  {preserve}} = 0.80$ threshold. The clipped variance-preserving branch does not trigger anywhere in the universe ($\rho _i < 0.90$ for all tickers) and is omitted. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) attain a KS pass rate of $99\%$, consistent with the branch recovering both $\beta $ and $R^2$ by construction.}}{28}{table.caption.23}\protected@file@percent }
\newlabel{tab:branch}{{S4}{28}{\textbf {Hybrid composition method broken out by branch.} $N_{\mathrm {tickers}}$: number of tickers assigned to each branch by the $R^2_{\mathrm {preserve}} = 0.80$ threshold. The clipped variance-preserving branch does not trigger anywhere in the universe ($\rho _i < 0.90$ for all tickers) and is omitted. The two trackers in the $R^2$-preserving branch (QQQ and SPYG) attain a KS pass rate of $99\%$, consistent with the branch recovering both $\beta $ and $R^2$ by construction}{table.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Branch assignment in calibrated $(\beta , R^2_{\mathrm  {real}})$ space.} The $R^2_{\mathrm  {preserve}} = 0.80$ threshold (dashed line) separates tracker assets from single stocks. In this universe, only QQQ and SPYG exceed the threshold, and both are assigned to the $R^2$-preserving branch. The remaining $421$ tickers populate the variance-preserving branch; the clipped variance-preserving branch is unused because the market loading ratio $\rho _i = \beta _i^2 \sigma _m^2 / \sigma _{\mathrm  {gen},i}^2$ stays below $0.90$ for every ticker.}}{29}{figure.caption.24}\protected@file@percent }
\newlabel{fig:branch_map}{{S6}{29}{\textbf {Branch assignment in calibrated $(\beta , R^2_{\real })$ space.} The $R^2_{\mathrm {preserve}} = 0.80$ threshold (dashed line) separates tracker assets from single stocks. In this universe, only QQQ and SPYG exceed the threshold, and both are assigned to the $R^2$-preserving branch. The remaining $421$ tickers populate the variance-preserving branch; the clipped variance-preserving branch is unused because the market loading ratio $\rho _i = \beta _i^2 \sigma _m^2 / \sigma _{\gen ,i}^2$ stays below $0.90$ for every ticker}{figure.caption.24}{}}
