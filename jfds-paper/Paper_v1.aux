\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Aggregate metrics by $\beta $ quartile, across composition methods.} Quartile cutoffs are computed from the calibrated $\beta $ distribution across the $423$-ticker universe. The hybrid KS pass rate declines gently from $67\%$ in Q1 to $44\%$ in Q4 as the market loading ratio $\rho _i$ grows, consistent with the tail-attenuation caveat noted alongside Algorithm~\ref {alg:hybrid}; the naive KS pass rate falls from $16\%$ to under $1\%$ over the same range.}}{30}{table.caption.25}\protected@file@percent }
\newlabel{tab:beta_bucket}{{S5}{30}{\textbf {Aggregate metrics by $\beta $ quartile, across composition methods.} Quartile cutoffs are computed from the calibrated $\beta $ distribution across the $423$-ticker universe. The hybrid KS pass rate declines gently from $67\%$ in Q1 to $44\%$ in Q4 as the market loading ratio $\rho _i$ grows, consistent with the tail-attenuation caveat noted alongside Algorithm~\ref {alg:hybrid}; the naive KS pass rate falls from $16\%$ to under $1\%$ over the same range}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {Clipping-branch stress test under market-volatility scaling.} The market growth-rate path was rescaled by $\gamma \in \{1, 2, 3\}$ with the calibrated marginals held fixed, and the full hybrid composition method re-evaluated on the $423$-ticker universe. As $\gamma $ rises, the share of clipped tickers grows and the hybrid KS pass rate increases rather than falls.}}{30}{table.caption.26}\protected@file@percent }
\newlabel{tab:stress}{{S6}{30}{\textbf {Clipping-branch stress test under market-volatility scaling.} The market growth-rate path was rescaled by $\gamma \in \{1, 2, 3\}$ with the calibrated marginals held fixed, and the full hybrid composition method re-evaluated on the $423$-ticker universe. As $\gamma $ rises, the share of clipped tickers grows and the hybrid KS pass rate increases rather than falls}{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm  {paths}} = 200$ and $\mathrm  {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reproducible at the stated tune configuration but the composite objective has multiple near-equivalent local minima, so they are reported as the parameter values used for the IS / OoS fit metrics rather than as canonical per-ticker optima.}}{30}{table.caption.28}\protected@file@percent }
\newlabel{tab:cross_asset}{{S7}{30}{\textbf {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm {paths}} = 200$ and $\mathrm {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reproducible at the stated tune configuration but the composite objective has multiple near-equivalent local minima, so they are reported as the parameter values used for the IS / OoS fit metrics rather than as canonical per-ticker optima}{table.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Hybrid KS pass rate across a $5 \times 5$ hyperparameter grid.} Columns index the $R^2$-preserve threshold $R^2_{\mathrm  {preserve}} \in \{0.70, 0.75, 0.80, 0.85, 0.90\}$; rows index the idiosyncratic floor $f \in \{0.05, 0.10, 0.15, 0.20, 0.30\}$. Hybrid KS pass rate varies from $50.24\%$ to $50.38\%$ across the $25$ cells, a spread of $0.14$ percentage points. The parameter values $(0.80, 0.10)$ used throughout the paper are indistinguishable from every other grid point within sampling noise, indicating that the main result is not a data-peeked local optimum.}}{31}{figure.caption.27}\protected@file@percent }
\newlabel{fig:sensitivity}{{S7}{31}{\textbf {Hybrid KS pass rate across a $5 \times 5$ hyperparameter grid.} Columns index the $R^2$-preserve threshold $R^2_{\mathrm {preserve}} \in \{0.70, 0.75, 0.80, 0.85, 0.90\}$; rows index the idiosyncratic floor $f \in \{0.05, 0.10, 0.15, 0.20, 0.30\}$. Hybrid KS pass rate varies from $50.24\%$ to $50.38\%$ across the $25$ cells, a spread of $0.14$ percentage points. The parameter values $(0.80, 0.10)$ used throughout the paper are indistinguishable from every other grid point within sampling noise, indicating that the main result is not a data-peeked local optimum}{figure.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The between-composition-method differences in KS pass rate exceed the seed-induced SD by roughly two orders of magnitude (hybrid SD $0.18$ pp vs $25$ pp gap to JumpHMM-on-residuals).}}{31}{table.caption.29}\protected@file@percent }
\newlabel{tab:seed_uncertainty}{{S8}{31}{\textbf {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The between-composition-method differences in KS pass rate exceed the seed-induced SD by roughly two orders of magnitude (hybrid SD $0.18$ pp vs $25$ pp gap to JumpHMM-on-residuals)}{table.caption.29}{}}
