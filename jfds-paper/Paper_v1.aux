\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Calibrated $R^2$ distribution across the $423$ non-SPY tickers.} Histogram of OLS $R^2$ against SPY over the $2014$--$2024$ window. The two tickers crossing the $R^2_{\mathrm  {preserve}} = 0.80$ threshold (dashed line) are index ETFs (QQQ, SPYG); the highest-$R^2$ individual stock (BLK, $0.645$) sits $\sim 0.22$ below the threshold. The $R^2$-preserving branch's $n = 2$ occupancy is therefore a property of the single-factor SIM on S\&P 500 names against SPY, not a sample-size artifact or a data-peeked threshold.}}{26}{figure.caption.17}\protected@file@percent }
\newlabel{fig:r2_distribution}{{S3}{26}{\textbf {Calibrated $R^2$ distribution across the $423$ non-SPY tickers.} Histogram of OLS $R^2$ against SPY over the $2014$--$2024$ window. The two tickers crossing the $R^2_{\mathrm {preserve}} = 0.80$ threshold (dashed line) are index ETFs (QQQ, SPYG); the highest-$R^2$ individual stock (BLK, $0.645$) sits $\sim 0.22$ below the threshold. The $R^2$-preserving branch's $n = 2$ occupancy is therefore a property of the single-factor SIM on S\&P 500 names against SPY, not a sample-size artifact or a data-peeked threshold}{figure.caption.17}{}}
