\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {In-sample and out-of-sample model comparison for SPY.} Results summarize $1{,}000$ simulated paths. Values in parentheses are standard errors, and bold entries are best among the fitted generative models within each panel; the empirical bootstrap is excluded from this highlighting. Metric definitions and standard-error calculations are given in Online Appendix~\ref {sec:supp-validation}.}}{16}{}\protected@file@percent }
