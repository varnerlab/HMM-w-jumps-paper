\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Aggregate scorecard across $423$ non-market tickers and $100$ replications per ticker.} Median values per composer. $|\hat  \beta - \beta |$ and $|\hat  R^2 - R^2_{\mathrm  {real}}|$: absolute deviation between OLS recovery and calibration. KS pass and AD pass: fraction of replications whose two-sample test against the real marginal exceeds $p = 0.05$. $W_1$: Wasserstein-1 distance to the real marginal. $\kappa $: sample excess kurtosis. Hill: tail-index estimate on the upper $5\%$ of $|g|$. All three composers recover $\beta $ to the same precision; only the hybrid composer preserves the marginal distribution (KS pass $50.4\%$) while holding the variance close to the generator target.}}{12}{table.caption.6}\protected@file@percent }
\newlabel{tab:aggregate}{{2}{12}{\textbf {Aggregate scorecard across $423$ non-market tickers and $100$ replications per ticker.} Median values per composer. $|\hat \beta - \beta |$ and $|\hat R^2 - R^2_{\real }|$: absolute deviation between OLS recovery and calibration. KS pass and AD pass: fraction of replications whose two-sample test against the real marginal exceeds $p = 0.05$. $W_1$: Wasserstein-1 distance to the real marginal. $\kappa $: sample excess kurtosis. Hill: tail-index estimate on the upper $5\%$ of $|g|$. All three composers recover $\beta $ to the same precision; only the hybrid composer preserves the marginal distribution (KS pass $50.4\%$) while holding the variance close to the generator target}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Per-ticker one-day Value-at-Risk backtest across the six composers.} For each (ticker, replication) pair we estimate the VaR threshold at coverage level $\alpha $ from the composed path and count exceedances against the real $2014$--$2024$ growth-rate history. \textit  {rate}: mean exceedance rate across tickers (nominal: $1-\alpha $). \textit  {SD}: cross-ticker standard deviation of the exceedance rate, in percentage points. \textit  {Kupiec pass}: fraction of tickers on which the Kupiec unconditional-coverage test $p$-value exceeds $0.05$. Hybrid and JumpHMM-on-residuals are statistically indistinguishable at both coverage levels; the naive and Gaussian SIM composers fail coverage on a majority of the universe.}}{12}{table.caption.7}\protected@file@percent }
\newlabel{tab:var}{{3}{12}{\textbf {Per-ticker one-day Value-at-Risk backtest across the six composers.} For each (ticker, replication) pair we estimate the VaR threshold at coverage level $\alpha $ from the composed path and count exceedances against the real $2014$--$2024$ growth-rate history. \textit {rate}: mean exceedance rate across tickers (nominal: $1-\alpha $). \textit {SD}: cross-ticker standard deviation of the exceedance rate, in percentage points. \textit {Kupiec pass}: fraction of tickers on which the Kupiec unconditional-coverage test $p$-value exceeds $0.05$. Hybrid and JumpHMM-on-residuals are statistically indistinguishable at both coverage levels; the naive and Gaussian SIM composers fail coverage on a majority of the universe}{table.caption.7}{}}
