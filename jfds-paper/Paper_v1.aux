\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Hybrid KS pass rate across a $5 \times 5$ hyperparameter grid.} Columns index the $R^2$-preserve threshold $R^2_{\mathrm  {preserve}} \in \{0.70, 0.75, 0.80, 0.85, 0.90\}$; rows index the idiosyncratic floor $f \in \{0.05, 0.10, 0.15, 0.20, 0.30\}$. Hybrid KS pass rate varies from $50.24\%$ to $50.38\%$ across the $25$ cells, a spread of $0.14$ percentage points. The parameter values $(0.80, 0.10)$ used throughout the paper produced a KS pass rate within this range.}}{29}{figure.caption.33}\protected@file@percent }
\newlabel{fig:sensitivity}{{S7}{29}{\textbf {Hybrid KS pass rate across a $5 \times 5$ hyperparameter grid.} Columns index the $R^2$-preserve threshold $R^2_{\mathrm {preserve}} \in \{0.70, 0.75, 0.80, 0.85, 0.90\}$; rows index the idiosyncratic floor $f \in \{0.05, 0.10, 0.15, 0.20, 0.30\}$. Hybrid KS pass rate varies from $50.24\%$ to $50.38\%$ across the $25$ cells, a spread of $0.14$ percentage points. The parameter values $(0.80, 0.10)$ used throughout the paper produced a KS pass rate within this range}{figure.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm  {paths}} = 200$ and $\mathrm  {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima.}}{29}{table.caption.34}\protected@file@percent }
\newlabel{tab:cross_asset}{{S7}{29}{\textbf {Cross-asset generalization of HMM-WJ across three single-stock tickers spanning sector and volatility regimes.} Per-ticker tune outputs $(\epsilon ^{*}, \lambda ^{*})$ at $n_{\mathrm {paths}} = 200$ and $\mathrm {seed} = 1234$, and the corresponding HMM-WJ pass rates on $1{,}000$ simulated paths at $\alpha = 0.05$ against each ticker's in-sample $(2014$--$2024)$ and out-of-sample $(2025)$ growth-rate history. Standard errors in parentheses (binomial SE for pass rates). The $(\epsilon ^{*}, \lambda ^{*})$ values are reported as the parameter values used for the IS / OoS metrics rather than as canonical per-ticker optima}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The hybrid--JumpHMM-on-residuals difference in KS pass rate is $25$ percentage points, compared with hybrid's across-seed SD of $0.18$ percentage points.}}{29}{table.caption.35}\protected@file@percent }
\newlabel{tab:seed_uncertainty}{{S8}{29}{\textbf {Seed-uncertainty summary across $8$ random seeds.} Each cell reports mean $\pm $ standard deviation (SD) across the $8$ seeds in $\{1234, 2345, 3456, 4567, 5678, 6789, 7890, 8910\}$, with each seed running the full $423$-ticker $\times \, 100$-replication protocol. Conditional-variance paths for GARCH(1,1)-$t$ are re-simulated at scoring time so its seed SD is informative. The hybrid--JumpHMM-on-residuals difference in KS pass rate is $25$ percentage points, compared with hybrid's across-seed SD of $0.18$ percentage points}{table.caption.35}{}}
