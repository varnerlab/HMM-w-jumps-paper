\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Per-ticker one-day Value-at-Risk coverage check across the six composition methods.} For each (ticker, replication) pair we estimate the VaR threshold at coverage level $\alpha $ from the composed path and count exceedances against the real $2014$--$2024$ growth-rate history. \textit  {rate}: mean exceedance rate across tickers (nominal: $1-\alpha $). \textit  {SD}: cross-ticker standard deviation of the exceedance rate, in percentage points. \textit  {Kupiec pass}: fraction of tickers on which the Kupiec unconditional-coverage test $p$-value exceeds $0.05$. Hybrid and JumpHMM-on-residuals differ by less than the cross-ticker spread at both coverage levels; naive composition and Gaussian SIM fail coverage on a majority of the universe.}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tab:var}{{3}{13}{\textbf {Per-ticker one-day Value-at-Risk coverage check across the six composition methods.} For each (ticker, replication) pair we estimate the VaR threshold at coverage level $\alpha $ from the composed path and count exceedances against the real $2014$--$2024$ growth-rate history. \textit {rate}: mean exceedance rate across tickers (nominal: $1-\alpha $). \textit {SD}: cross-ticker standard deviation of the exceedance rate, in percentage points. \textit {Kupiec pass}: fraction of tickers on which the Kupiec unconditional-coverage test $p$-value exceeds $0.05$. Hybrid and JumpHMM-on-residuals differ by less than the cross-ticker spread at both coverage levels; naive composition and Gaussian SIM fail coverage on a majority of the universe}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Hybrid's variance correction and its KS-pass-rate consequence, per ticker vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications; thick lines are binned medians. \emph  {Left (consequence):} Kolmogorov--Smirnov pass rate against the real marginal at $\alpha = 0.05$ for naive composition (blue) and hybrid (orange). \emph  {Right (mechanism):} variance ratio $\mathrm  {Var}(g)/\sigma ^2_{\mathrm  {gen}}$ for the same two methods. The dotted curve is the theoretical naive inflation $1 + \rho $ evaluated at the universe-median $\sigma ^2_{\mathrm  {gen}}$; the dashed line marks a variance ratio of one.}}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:preservation}{{5}{14}{\textbf {Hybrid's variance correction and its KS-pass-rate consequence, per ticker vs calibrated $\beta $.} Each point is a per-ticker median over $100$ replications; thick lines are binned medians. \emph {Left (consequence):} Kolmogorov--Smirnov pass rate against the real marginal at $\alpha = 0.05$ for naive composition (blue) and hybrid (orange). \emph {Right (mechanism):} variance ratio $\mathrm {Var}(g)/\sigma ^2_{\mathrm {gen}}$ for the same two methods. The dotted curve is the theoretical naive inflation $1 + \rho $ evaluated at the universe-median $\sigma ^2_{\mathrm {gen}}$; the dashed line marks a variance ratio of one}{figure.caption.9}{}}
